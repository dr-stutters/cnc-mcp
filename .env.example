# Copy to .env and fill in. All variables are prefixed CNC_MCP_ and are read
# from the server's working directory (or from the environment). This file is
# git-ignored and docker-ignored: credentials never leave the machine.

# Required: the Crosswork Network Controller UI/API URL, scheme included.
# CNC listens on Kubernetes NodePort 30603; the API shares it with the UI.
CNC_MCP_BASE_URL=https://cnc.example.com:30603

# Required (one of the two forms):
# 1. A Crosswork user with the 'admin' role, or a role covering the inventory,
#    topology, alarm and AAA read tasks (writes need inventory write). Auth is
#    Crosswork's two-leg CAS SSO -> Bearer JWT (8 h), refreshed automatically.
CNC_MCP_USERNAME=mcp-user
CNC_MCP_PASSWORD=change-me
# 2. Alternative: a pre-issued JWT. Cannot be refreshed; expires after ~8 h.
# CNC_MCP_API_TOKEN=

# TLS certificate verification. Set to false for a lab instance with a
# self-signed certificate.
CNC_MCP_VERIFY_TLS=true

# Safety: the write tools (create/update/delete of devices, credential
# profiles, providers, tags, alarms and alarm settings, templates, SR-TE
# policies, services, subscriptions, device groups, PM policies, ZTP objects,
# ...) are not registered at all until this is true.
CNC_MCP_ENABLE_WRITES=false

# Safety, finer-grained (defaults shown; uncomment to change). See the README's
# "Safety controls" and docs/RBAC.md for the account-side counterpart.
# Comma-separated areas whose write tools are registered when writes are on;
# empty = every area. An area is a module name under src/cnc_mcp/tools/
# (devices, credentials, providers, sr_te_operations, data_gateway, nso, admin,
# inventory_extras, fault, device_config, notifications, grouping, lcm_csm,
# service_provisioning, performance, oam, swim_ztp, ems_jobs, composite). Read
# tools are unaffected; the composite playbooks also need the area of the write
# they commit through (cnc_provision_l3vpn_e2e: service_provisioning;
# cnc_create_sr_policy_e2e: sr_te_operations). An unknown area is a startup
# error.
# CNC_MCP_WRITE_AREAS=fault,service_provisioning
# Comma-separated tool names that are never registered, read or write, whatever
# the settings above say. An unknown name is a startup error.
# CNC_MCP_DISABLED_TOOLS=cnc_delete_device,cnc_restart_microservice
# Global dry-run: the write tools stay registered but nothing changes on the
# platform — a tool with a dry_run argument runs with it forced to true and
# answers the preview; every other write is not executed and answers with the
# arguments it would have sent; the write playbooks stop after their preview.
# CNC_MCP_DRY_RUN=false

# Tuning (defaults shown; uncomment to change):
# Per-request read timeout, seconds (>= 1).
# CNC_MCP_TIMEOUT_SECONDS=30
# TCP connect timeout, seconds (>= 1).
# CNC_MCP_CONNECT_TIMEOUT_SECONDS=10
# Retries for 429 / 5xx / transport errors on idempotent calls (0-10).
# CNC_MCP_MAX_RETRIES=3
# Base delay for the exponential backoff between retries, seconds.
# CNC_MCP_RETRY_BACKOFF_SECONDS=1.0
# Cap on in-flight requests to the platform (1-50).
# CNC_MCP_MAX_CONCURRENT_REQUESTS=5
# Tool responses longer than this are truncated with a note (>= 1000).
# CNC_MCP_MAX_RESPONSE_CHARS=40000
# Python logging level. Logs go to stderr only; stdout is the MCP transport.
# CNC_MCP_LOG_LEVEL=INFO

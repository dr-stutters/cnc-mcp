# Copy to .env and fill in. All variables are prefixed CNC_MCP_.

# Required: the Crosswork Network Controller UI/API URL, scheme included.
# CNC listens on Kubernetes NodePort 30603; the API shares it with the UI.
CNC_MCP_BASE_URL=https://cnc.example.com:30603

# Required: a Crosswork user with the 'admin' role (or a role covering the
# inventory, topology, alarm, and AAA read tasks; writes need inventory write).
# Auth is Crosswork's two-leg CAS SSO -> Bearer JWT (8 h), handled for you.
CNC_MCP_USERNAME=mcp-admin
CNC_MCP_PASSWORD=changeme
# Alternative: a pre-issued JWT (cannot be refreshed; expires after ~8 h):
# CNC_MCP_API_TOKEN=

# Lab instances use a self-signed certificate:
CNC_MCP_VERIFY_TLS=false

# Safety: write tools (create/update/delete devices, credential profiles,
# providers) are not registered until this is true.
CNC_MCP_ENABLE_WRITES=false

# Tuning (defaults shown):
# CNC_MCP_TIMEOUT_SECONDS=30
# CNC_MCP_MAX_RETRIES=3
# CNC_MCP_MAX_CONCURRENT_REQUESTS=5
# CNC_MCP_MAX_RESPONSE_CHARS=40000
# CNC_MCP_LOG_LEVEL=INFO

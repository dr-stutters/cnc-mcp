# Copy to .env and fill in. The specialize script renames the prefix
# (e.g. CNC_MCP_ -> ACME_MCP_).

# Required: platform API base URL
CNC_MCP_BASE_URL=https://platform.example.com

# Credentials: username/password for basic or login-token auth...
CNC_MCP_USERNAME=apiuser
CNC_MCP_PASSWORD=changeme
# ...or a pre-issued static token instead:
# CNC_MCP_API_TOKEN=

# Lab gear usually has self-signed certs:
CNC_MCP_VERIFY_TLS=false

# Safety: write tools stay hidden until this is true.
CNC_MCP_ENABLE_WRITES=false

# Tuning (defaults shown):
# CNC_MCP_TIMEOUT_SECONDS=30
# CNC_MCP_MAX_RETRIES=3
# CNC_MCP_MAX_CONCURRENT_REQUESTS=5
# CNC_MCP_MAX_RESPONSE_CHARS=40000
# CNC_MCP_LOG_LEVEL=INFO

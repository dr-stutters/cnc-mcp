      "args": {}
    },
    {
      "tool": "cnc_list_sr_policies",
      "args": {}
    },
    {
      "tool": "cnc_list_sr_policies",
      "args": {
        "headend": "10.0.0.1",
        "oper_state": "up",
        "pce_controlled": true,
        "response_format": "json"
      }
    },
    {
      "tool": "cnc_list_sr_policies",
      "args": {
        "color": 999
      }
    },
    {
      "tool": "cnc_get_sr_policy",
      "args": {
        "headend": "10.0.0.1",
        "endpoint": "10.0.0.3",
        "color": 100
      }
    },
    {
      "tool": "cnc_get_sr_policy",
      "args": {
        "headend": "10.0.0.1",
        "endpoint": "10.0.0.3",
        "color": 100,
        "response_format": "json"
      }
    },
    {
      "tool": "cnc_get_sr_policy",
      "args": {
        "headend": "10.0.0.1",
        "endpoint": "10.0.0.3",
        "color": 999
      },
      "expect_error": true
    },
    {
      "tool": "cnc_list_p2mp_policies",
      "args": {}
    },
    {
      "tool": "cnc_get_p2mp_policy",
      "args": {
        "name": "nope"
      },
      "expect_error": true
    },
    {
      "tool": "cnc_list_rsvp_te_tunnels",
      "args": {}
    },
    {
      "tool": "cnc_get_rsvp_te_tunnel",
      "args": {
        "headend": "10.0.0.1",

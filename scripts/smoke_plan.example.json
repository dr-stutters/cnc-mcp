        "timeout_seconds": 20,
        "interval_seconds": 5
      }
    },
    {
      "tool": "cnc_list_credential_profiles",
      "args": {}
    },
    {
      "tool": "cnc_list_credential_profiles",
      "args": {
        "profile": "cml*",
        "response_format": "json"
      }
    },
    {
      "tool": "cnc_get_credential_profile",
      "args": {
        "profile": "cml-xrd"
      }
    },
    {
      "tool": "cnc_get_credential_profile",
      "args": {
        "profile": "nope"
      },
      "expect_error": true
    },
    {
      "tool": "cnc_list_providers",
      "args": {}
    },
    {
      "tool": "cnc_list_providers",
      "args": {
        "family": "sr_pce",
        "response_format": "json"
      }
    },
    {
      "tool": "cnc_get_provider",
      "args": {
        "name": "cml-pce"
      }
    },
    {
      "tool": "cnc_get_provider",
      "args": {
        "name": "nope"
      },
      "expect_error": true
    },
    {
      "tool": "cnc_get_topology_summary",
      "args": {}
    },
    {
      "tool": "cnc_list_topology_nodes",
      "args": {}
    },
    {
      "tool": "cnc_list_topology_nodes",
      "args": {
        "name": "PE*",
        "sr_only": true,
        "response_format": "json",
        "page_size": 1,
        "page": 1
      }
    },
    {
      "tool": "cnc_get_topology_node",
      "args": {
        "node_id": "PE1"
      }
    },
    {
      "tool": "cnc_get_topology_node",
      "args": {
        "node_id": "PE1",
        "response_format": "json"
      }
    },
    {
      "tool": "cnc_get_topology_node",
      "args": {
        "node_id": "nope"
      },
      "expect_error": true
    },
    {
      "tool": "cnc_list_node_interfaces",
      "args": {
        "node_id": "P1"
      }
    },
    {
      "tool": "cnc_get_node_interface",
      "args": {
        "node_id": "PE1",
        "tp_id": "GigabitEthernet0/0/0/0"
      }
    },
    {
      "tool": "cnc_get_node_interface",
      "args": {
        "node_id": "PE1",
        "tp_id": "GigabitEthernet0/0/0/9"
      },
      "expect_error": true
    },
    {
      "tool": "cnc_list_topology_links",
      "args": {}
    },
    {
      "tool": "cnc_list_topology_links",
      "args": {
        "link_type": "isis",
        "node": "PE1",
        "response_format": "json"
      }
    },
    {
      "tool": "cnc_list_topology_links",
      "args": {
        "link_type": "ethernet",
        "page_size": 3,
        "page": 1
      }
    },
    {
      "tool": "cnc_get_topology_link",
      "args": {
        "link_id": "P2 : GigabitEthernet0/0/0/0 : PE2 : GigabitEthernet0/0/0/1 : ISIS_IPV4_L2"
      }
    },
    {
      "tool": "cnc_get_topology_link",
      "args": {
        "link_id": "does : not : exist : a : b : ISIS_IPV4_L2"
